@SingularFlow.Api_HostAddress = http://localhost:5278
@SimulationId = replace-with-a-simulation-id
@simulationJobId = replace-with-returned-job-id

### Liveness health check

GET {{SingularFlow.Api_HostAddress}}/health/live
Accept: text/plain

### Readiness health check

GET {{SingularFlow.Api_HostAddress}}/health/ready
Accept: text/plain

### Compatibility readiness health check

GET {{SingularFlow.Api_HostAddress}}/health
Accept: text/plain

### OpenAPI document

GET {{SingularFlow.Api_HostAddress}}/openapi/v1.json
Accept: application/json

### Submit a durable simulation job
# Returns 202 Accepted. Copy the returned id into simulationJobId above.
# Processing occurs asynchronously through the hosted worker.

POST {{SingularFlow.Api_HostAddress}}/api/simulation-jobs
Content-Type: application/json
Accept: application/json

{
  "singularTime": 1.0,
  "concentrationExponent": 0.005,
  "startTime": 0.0,
  "endTime": 0.9,
  "sampleCount": 100,
  "samplingMode": "logarithmic"
}

### Get durable simulation-job status
# Uses the id returned by the submission request above.

GET {{SingularFlow.Api_HostAddress}}/api/simulation-jobs/{{simulationJobId}}
Accept: application/json

### Synchronous simulation examples remain available below

### Run logarithmic simulation

POST {{SingularFlow.Api_HostAddress}}/api/simulations
Content-Type: application/json
Accept: application/json

{
  "singularTime": 1.0,
  "concentrationExponent": 0.005,
  "startTime": 0.0,
  "endTime": 0.9999,
  "sampleCount": 6,
  "samplingMode": "logarithmic"
}

### Run uniform simulation

POST {{SingularFlow.Api_HostAddress}}/api/simulations
Content-Type: application/json
Accept: application/json

{
  "singularTime": 1.0,
  "concentrationExponent": 0.005,
  "startTime": 0.0,
  "endTime": 0.8,
  "sampleCount": 5,
  "samplingMode": "uniform"
}

### Unsupported sampling mode

POST {{SingularFlow.Api_HostAddress}}/api/simulations
Content-Type: application/json
Accept: application/problem+json

{
  "singularTime": 1.0,
  "concentrationExponent": 0.005,
  "startTime": 0.0,
  "endTime": 0.9999,
  "sampleCount": 6,
  "samplingMode": "adaptive"
}

### Malformed JSON example

POST {{SingularFlow.Api_HostAddress}}/api/simulations
Content-Type: application/json
Accept: application/problem+json

{
  "singularTime": 1.0,

### List persisted simulations

GET {{SingularFlow.Api_HostAddress}}/api/simulations?page=1&pageSize=20
Accept: application/json

### Get a persisted simulation

GET {{SingularFlow.Api_HostAddress}}/api/simulations/{{SimulationId}}
Accept: application/json

### Delete a persisted simulation

DELETE {{SingularFlow.Api_HostAddress}}/api/simulations/{{SimulationId}}
Accept: application/problem+json
