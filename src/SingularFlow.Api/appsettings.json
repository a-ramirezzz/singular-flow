{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SimulationJobs": {
    "Worker": {
      "Enabled": true,
      "PollingInterval": "00:00:05",
      "FailureDelay": "00:00:10",
      "LeaseDuration": "00:00:30",
      "HeartbeatInterval": "00:00:10",
      "RecoveryInterval": "00:00:30",
      "RecoveryBatchSize": 100
    }
  },
  "AllowedHosts": "*"
}
